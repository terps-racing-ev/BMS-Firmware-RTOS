  48:Core/Src/cell_temp_handler.c **** /**
  49:Core/Src/cell_temp_handler.c ****   * @brief  Initialize cell temperature monitoring system
  50:Core/Src/cell_temp_handler.c ****   * @retval HAL_StatusTypeDef
  51:Core/Src/cell_temp_handler.c ****   */
  52:Core/Src/cell_temp_handler.c **** HAL_StatusTypeDef CellTemp_Init(void)
  53:Core/Src/cell_temp_handler.c **** {
  54:Core/Src/cell_temp_handler.c ****     // Initialize state structure
  55:Core/Src/cell_temp_handler.c ****     memset(&temp_state, 0, sizeof(temp_monitor_state_t));
  56:Core/Src/cell_temp_handler.c **** 
  57:Core/Src/cell_temp_handler.c ****     // Initialize thermistor data
  58:Core/Src/cell_temp_handler.c ****     for (uint8_t i = 0; i < TOTAL_THERMISTORS; i++) {
  59:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].adc_index = i / MUX_CHANNELS;
  60:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].mux_channel = i % MUX_CHANNELS;
  61:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].temperature = -127.0f; // Invalid temperature marker
  62:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].raw_adc = 0;
  63:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].last_read_time = 0;
  64:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].adc_accumulator = 0;
  65:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].sample_count = 0;
  66:Core/Src/cell_temp_handler.c ****     }
  67:Core/Src/cell_temp_handler.c **** 
  68:Core/Src/cell_temp_handler.c ****     // Note: ADC calibration is already done in main() before RTOS starts
  69:Core/Src/cell_temp_handler.c **** 
  70:Core/Src/cell_temp_handler.c ****     // Initialize MUX control signals to 0 (without calling osDelay)
  71:Core/Src/cell_temp_handler.c ****     HAL_GPIO_WritePin(MUX_SIG1_PORT, MUX_SIG1_PIN, GPIO_PIN_RESET);
  72:Core/Src/cell_temp_handler.c ****     HAL_GPIO_WritePin(MUX_SIG2_PORT, MUX_SIG2_PIN, GPIO_PIN_RESET);
  73:Core/Src/cell_temp_handler.c ****     HAL_GPIO_WritePin(MUX_SIG3_PORT, MUX_SIG3_PIN, GPIO_PIN_RESET);
  74:Core/Src/cell_temp_handler.c **** 
  75:Core/Src/cell_temp_handler.c ****     return HAL_OK;
  76:Core/Src/cell_temp_handler.c **** }
