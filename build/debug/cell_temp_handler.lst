 125:Core/Src/cell_temp_handler.c **** /**
 126:Core/Src/cell_temp_handler.c ****   * @brief  Set MUX channel using 3-bit digital control signals
 127:Core/Src/cell_temp_handler.c ****   * @param  channel: MUX channel to select (0-7)
 128:Core/Src/cell_temp_handler.c ****   * @retval None
 129:Core/Src/cell_temp_handler.c ****   */
 130:Core/Src/cell_temp_handler.c **** void CellTemp_SetMuxChannel(uint8_t channel)
 131:Core/Src/cell_temp_handler.c **** {
 132:Core/Src/cell_temp_handler.c ****     // Validate channel range
 133:Core/Src/cell_temp_handler.c ****     if (channel > 7) {
 134:Core/Src/cell_temp_handler.c ****         return;
 135:Core/Src/cell_temp_handler.c ****     }
 136:Core/Src/cell_temp_handler.c ****     
 137:Core/Src/cell_temp_handler.c ****     // Set MUX control signals based on 3-bit channel value
 138:Core/Src/cell_temp_handler.c ****     // MUX_SIG1 = bit 0
 139:Core/Src/cell_temp_handler.c ****     // MUX_SIG2 = bit 1  
 140:Core/Src/cell_temp_handler.c ****     // MUX_SIG3 = bit 2
 141:Core/Src/cell_temp_handler.c ****     
 142:Core/Src/cell_temp_handler.c ****     if (channel & 0x01) {
 143:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG1_PORT, MUX_SIG1_PIN, GPIO_PIN_SET);
 144:Core/Src/cell_temp_handler.c ****     } else {
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccPZGYZi.s 			page 4


 145:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG1_PORT, MUX_SIG1_PIN, GPIO_PIN_RESET);
 146:Core/Src/cell_temp_handler.c ****     }
 147:Core/Src/cell_temp_handler.c ****     
 148:Core/Src/cell_temp_handler.c ****     if (channel & 0x02) {
 149:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG2_PORT, MUX_SIG2_PIN, GPIO_PIN_SET);
 150:Core/Src/cell_temp_handler.c ****     } else {
 151:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG2_PORT, MUX_SIG2_PIN, GPIO_PIN_RESET);
 152:Core/Src/cell_temp_handler.c ****     }
 153:Core/Src/cell_temp_handler.c ****     
 154:Core/Src/cell_temp_handler.c ****     if (channel & 0x04) {
 155:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG3_PORT, MUX_SIG3_PIN, GPIO_PIN_SET);
 156:Core/Src/cell_temp_handler.c ****     } else {
 157:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG3_PORT, MUX_SIG3_PIN, GPIO_PIN_RESET);
 158:Core/Src/cell_temp_handler.c ****     }
 159:Core/Src/cell_temp_handler.c ****     
 160:Core/Src/cell_temp_handler.c ****     // Allow time for MUX to settle (2 ticks = 2ms at default 1ms tick rate)
 161:Core/Src/cell_temp_handler.c ****     osDelay(2);
 162:Core/Src/cell_temp_handler.c **** }
 163:Core/Src/cell_temp_handler.c **** 
 164:Core/Src/cell_temp_handler.c **** /**
 165:Core/Src/cell_temp_handler.c ****   * @brief  Calculate temperature from thermistor ADC reading using B-parameter equation
 166:Core/Src/cell_temp_handler.c ****   * @param  adc_value: Raw ADC value (0-4095)
 167:Core/Src/cell_temp_handler.c ****   * @retval Temperature in degrees Celsius
 168:Core/Src/cell_temp_handler.c ****   */
 169:Core/Src/cell_temp_handler.c **** float CellTemp_CalculateTemperature(uint16_t adc_value)
 170:Core/Src/cell_temp_handler.c **** {
 171:Core/Src/cell_temp_handler.c ****     // Convert ADC value to voltage
 172:Core/Src/cell_temp_handler.c ****     float voltage = ((float)adc_value / ADC_RESOLUTION) * ADC_VREF;
 173:Core/Src/cell_temp_handler.c ****     
 174:Core/Src/cell_temp_handler.c ****     // Check for disconnected thermistor (very low ADC reading means low voltage = open circuit)
 175:Core/Src/cell_temp_handler.c ****     if (adc_value < 10) {  // Less than ~8mV indicates disconnected sensor
 176:Core/Src/cell_temp_handler.c ****         return -127.0f;  // Return obvious error value
 177:Core/Src/cell_temp_handler.c ****     }
 178:Core/Src/cell_temp_handler.c ****     
 179:Core/Src/cell_temp_handler.c ****     // Calculate thermistor resistance using voltage divider
 180:Core/Src/cell_temp_handler.c ****     // Circuit: 3.3V -> 10kΩ pullup -> ADC_input -> Thermistor -> GND
 181:Core/Src/cell_temp_handler.c ****     // Voltage divider: V_adc = 3.3V * (R_thermistor / (R_pullup + R_thermistor))
 182:Core/Src/cell_temp_handler.c ****     // Solving for R_thermistor: R_thermistor = (V_adc * R_pullup) / (3.3V - V_adc)
 183:Core/Src/cell_temp_handler.c ****     
 184:Core/Src/cell_temp_handler.c ****     float r_thermistor;
 185:Core/Src/cell_temp_handler.c ****     
 186:Core/Src/cell_temp_handler.c ****     if (voltage >= 3.29f) {  // Close to 3.3V limit, very high resistance (cold)
 187:Core/Src/cell_temp_handler.c ****         r_thermistor = PULLUP_RESISTOR * 100.0f;  // Assume very high resistance
 188:Core/Src/cell_temp_handler.c ****     } else {
 189:Core/Src/cell_temp_handler.c ****         // Normal calculation with 3.3V supply
 190:Core/Src/cell_temp_handler.c ****         r_thermistor = (voltage * PULLUP_RESISTOR) / (ADC_VREF - voltage);
 191:Core/Src/cell_temp_handler.c ****     }
 192:Core/Src/cell_temp_handler.c ****     
 193:Core/Src/cell_temp_handler.c ****     // Handle edge cases
 194:Core/Src/cell_temp_handler.c ****     if (r_thermistor <= 0) {
 195:Core/Src/cell_temp_handler.c ****         return 125.0f; // Return maximum temperature for very low resistance
 196:Core/Src/cell_temp_handler.c ****     }
 197:Core/Src/cell_temp_handler.c ****     
 198:Core/Src/cell_temp_handler.c ****     // Calculate temperature using B-parameter equation (derived from Steinhart-Hart)
 199:Core/Src/cell_temp_handler.c ****     // 1/T = 1/T0 + (1/B) * ln(R/R0)
 200:Core/Src/cell_temp_handler.c ****     // Where T0 = 298.15K (25°C), R0 = resistance at 25°C, B = B-value
 201:Core/Src/cell_temp_handler.c ****     float ln_ratio = logf(r_thermistor / THERMISTOR_R25);
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccPZGYZi.s 			page 5


 202:Core/Src/cell_temp_handler.c ****     float temp_kelvin = 1.0f / ((1.0f / REFERENCE_TEMP_K) + (ln_ratio / THERMISTOR_B_VALUE));
 203:Core/Src/cell_temp_handler.c ****     
 204:Core/Src/cell_temp_handler.c ****     // Convert to Celsius
 205:Core/Src/cell_temp_handler.c ****     float temp_celsius = temp_kelvin - 273.15f;
 206:Core/Src/cell_temp_handler.c ****     
 207:Core/Src/cell_temp_handler.c ****     // Clamp to reasonable range
 208:Core/Src/cell_temp_handler.c ****     if (temp_celsius < -40.0f) {
 209:Core/Src/cell_temp_handler.c ****         temp_celsius = -40.0f;
 210:Core/Src/cell_temp_handler.c ****     } else if (temp_celsius > 125.0f) {
 211:Core/Src/cell_temp_handler.c ****         temp_celsius = 125.0f;
 212:Core/Src/cell_temp_handler.c ****     }
 213:Core/Src/cell_temp_handler.c ****     
 214:Core/Src/cell_temp_handler.c ****     return temp_celsius;
 215:Core/Src/cell_temp_handler.c **** }
 216:Core/Src/cell_temp_handler.c **** 
 217:Core/Src/cell_temp_handler.c **** /**
 218:Core/Src/cell_temp_handler.c ****   * @brief  Read temperature from specific thermistor
 219:Core/Src/cell_temp_handler.c ****   * @param  adc_index: ADC channel index (0-6)
 220:Core/Src/cell_temp_handler.c ****   * @param  mux_channel: MUX channel (0-7)
 221:Core/Src/cell_temp_handler.c ****   * @retval Temperature in degrees Celsius
 222:Core/Src/cell_temp_handler.c ****   */
 223:Core/Src/cell_temp_handler.c **** float CellTemp_ReadThermistor(uint8_t adc_index, uint8_t mux_channel)
 224:Core/Src/cell_temp_handler.c **** {
 225:Core/Src/cell_temp_handler.c ****     // Validate inputs
 226:Core/Src/cell_temp_handler.c ****     if (adc_index >= NUM_ADC_CHANNELS || mux_channel >= MUX_CHANNELS) {
 227:Core/Src/cell_temp_handler.c ****         return -127.0f;
 228:Core/Src/cell_temp_handler.c ****     }
 229:Core/Src/cell_temp_handler.c ****     
 230:Core/Src/cell_temp_handler.c ****     // Set MUX to desired channel
 231:Core/Src/cell_temp_handler.c ****     CellTemp_SetMuxChannel(mux_channel);
 232:Core/Src/cell_temp_handler.c ****     
 233:Core/Src/cell_temp_handler.c ****     // Read ADC value from the specified ADC channel
 234:Core/Src/cell_temp_handler.c ****     uint16_t adc_value = CellTemp_ReadADC(adc_channels[adc_index]);
 235:Core/Src/cell_temp_handler.c ****     
 236:Core/Src/cell_temp_handler.c ****     // Calculate temperature
 237:Core/Src/cell_temp_handler.c ****     return CellTemp_CalculateTemperature(adc_value);
 238:Core/Src/cell_temp_handler.c **** }
 239:Core/Src/cell_temp_handler.c **** 
 240:Core/Src/cell_temp_handler.c **** /**
 241:Core/Src/cell_temp_handler.c ****   * @brief  Main temperature monitoring task (to be called from ReadCellTemps)
 242:Core/Src/cell_temp_handler.c ****   * @param  argument: Not used
 243:Core/Src/cell_temp_handler.c ****   * @retval None
 244:Core/Src/cell_temp_handler.c ****   */
 245:Core/Src/cell_temp_handler.c **** void CellTemp_MonitorTask(void *argument)
 246:Core/Src/cell_temp_handler.c **** {
 247:Core/Src/cell_temp_handler.c ****     // Initialize the temperature monitoring system
 248:Core/Src/cell_temp_handler.c ****     if (CellTemp_Init() != HAL_OK) {
 249:Core/Src/cell_temp_handler.c ****         // Handle initialization error - blink would go here if we had an LED
 250:Core/Src/cell_temp_handler.c ****         while(1) {
 251:Core/Src/cell_temp_handler.c ****             osDelay(1000);  // Wait 1 second (1000 ticks at 1ms tick rate)
 252:Core/Src/cell_temp_handler.c ****         }
 253:Core/Src/cell_temp_handler.c ****     }
 254:Core/Src/cell_temp_handler.c ****     
 255:Core/Src/cell_temp_handler.c ****     // Strategy: Oversample each MUX channel for 125ms, then send CAN updates
 256:Core/Src/cell_temp_handler.c ****     // - Set MUX channel once
 257:Core/Src/cell_temp_handler.c ****     // - Sample all 7 ADC channels every 10ms for 125ms (12 samples each)
 258:Core/Src/cell_temp_handler.c ****     // - Average the samples to get accurate readings
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccPZGYZi.s 			page 6


 259:Core/Src/cell_temp_handler.c ****     // - Send CAN messages with updated values for all 7 ADCs
 260:Core/Src/cell_temp_handler.c ****     // - Move to next MUX channel and repeat
 261:Core/Src/cell_temp_handler.c ****     // Complete cycle time: 125ms × 8 MUX channels = 1 second
 262:Core/Src/cell_temp_handler.c ****     
 263:Core/Src/cell_temp_handler.c ****     /* Infinite loop */
 264:Core/Src/cell_temp_handler.c ****     for(;;)
 265:Core/Src/cell_temp_handler.c ****     {
 266:Core/Src/cell_temp_handler.c ****         // Set the current MUX channel for all ADCs
 267:Core/Src/cell_temp_handler.c ****         CellTemp_SetMuxChannel(temp_state.current_mux);
 268:Core/Src/cell_temp_handler.c ****         
 269:Core/Src/cell_temp_handler.c ****         // Reset accumulators for this MUX channel (across all ADC channels)
 270:Core/Src/cell_temp_handler.c ****         for (uint8_t adc = 0; adc < NUM_ADC_CHANNELS; adc++) {
 271:Core/Src/cell_temp_handler.c ****             if (CellTemp_IsADCEnabled(adc)) {
 272:Core/Src/cell_temp_handler.c ****                 uint8_t therm_idx = adc * MUX_CHANNELS + temp_state.current_mux;
 273:Core/Src/cell_temp_handler.c ****                 temp_state.thermistors[therm_idx].adc_accumulator = 0;
 274:Core/Src/cell_temp_handler.c ****                 temp_state.thermistors[therm_idx].sample_count = 0;
 275:Core/Src/cell_temp_handler.c ****             }
 276:Core/Src/cell_temp_handler.c ****         }
 277:Core/Src/cell_temp_handler.c ****         
 278:Core/Src/cell_temp_handler.c ****         // Oversample for 500ms (50 samples at 10ms intervals)
 279:Core/Src/cell_temp_handler.c ****         for (uint16_t sample = 0; sample < TEMP_SAMPLES_PER_MUX; sample++) {
 280:Core/Src/cell_temp_handler.c ****             // Read all enabled ADC channels for current MUX channel
 281:Core/Src/cell_temp_handler.c ****             for (uint8_t adc = 0; adc < NUM_ADC_CHANNELS; adc++) {
 282:Core/Src/cell_temp_handler.c ****                 if (CellTemp_IsADCEnabled(adc)) {
