 127:Core/Src/cell_temp_handler.c **** /**
 128:Core/Src/cell_temp_handler.c ****   * @brief  Set MUX channel using 3-bit digital control signals
 129:Core/Src/cell_temp_handler.c ****   * @param  channel: MUX channel to select (0-7)
 130:Core/Src/cell_temp_handler.c ****   * @retval None
 131:Core/Src/cell_temp_handler.c ****   */
 132:Core/Src/cell_temp_handler.c **** void CellTemp_SetMuxChannel(uint8_t channel)
 133:Core/Src/cell_temp_handler.c **** {
 134:Core/Src/cell_temp_handler.c ****     // Validate channel range
 135:Core/Src/cell_temp_handler.c ****     if (channel > 7) {
 136:Core/Src/cell_temp_handler.c ****         return;
 137:Core/Src/cell_temp_handler.c ****     }
 138:Core/Src/cell_temp_handler.c ****     
 139:Core/Src/cell_temp_handler.c ****     // Set MUX control signals based on 3-bit channel value
 140:Core/Src/cell_temp_handler.c ****     // MUX_SIG1 = bit 0
 141:Core/Src/cell_temp_handler.c ****     // MUX_SIG2 = bit 1  
 142:Core/Src/cell_temp_handler.c ****     // MUX_SIG3 = bit 2
 143:Core/Src/cell_temp_handler.c ****     
 144:Core/Src/cell_temp_handler.c ****     if (channel & 0x01) {
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccr7DEtS.s 			page 4


 145:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG1_PORT, MUX_SIG1_PIN, GPIO_PIN_SET);
 146:Core/Src/cell_temp_handler.c ****     } else {
 147:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG1_PORT, MUX_SIG1_PIN, GPIO_PIN_RESET);
 148:Core/Src/cell_temp_handler.c ****     }
 149:Core/Src/cell_temp_handler.c ****     
 150:Core/Src/cell_temp_handler.c ****     if (channel & 0x02) {
 151:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG2_PORT, MUX_SIG2_PIN, GPIO_PIN_SET);
 152:Core/Src/cell_temp_handler.c ****     } else {
 153:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG2_PORT, MUX_SIG2_PIN, GPIO_PIN_RESET);
 154:Core/Src/cell_temp_handler.c ****     }
 155:Core/Src/cell_temp_handler.c ****     
 156:Core/Src/cell_temp_handler.c ****     if (channel & 0x04) {
 157:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG3_PORT, MUX_SIG3_PIN, GPIO_PIN_SET);
 158:Core/Src/cell_temp_handler.c ****     } else {
 159:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG3_PORT, MUX_SIG3_PIN, GPIO_PIN_RESET);
 160:Core/Src/cell_temp_handler.c ****     }
 161:Core/Src/cell_temp_handler.c ****     
 162:Core/Src/cell_temp_handler.c ****     // Allow time for MUX to settle (2 ticks = 2ms at default 1ms tick rate)
 163:Core/Src/cell_temp_handler.c ****     osDelay(2);
 164:Core/Src/cell_temp_handler.c **** }
 165:Core/Src/cell_temp_handler.c **** 
 166:Core/Src/cell_temp_handler.c **** /**
 167:Core/Src/cell_temp_handler.c ****   * @brief  Calculate temperature from thermistor ADC reading using B-parameter equation
 168:Core/Src/cell_temp_handler.c ****   * @param  adc_value: Raw ADC value (0-4095)
 169:Core/Src/cell_temp_handler.c ****   * @retval Temperature in degrees Celsius
 170:Core/Src/cell_temp_handler.c ****   */
 171:Core/Src/cell_temp_handler.c **** float CellTemp_CalculateTemperature(uint16_t adc_value)
 172:Core/Src/cell_temp_handler.c **** {
 173:Core/Src/cell_temp_handler.c ****     // Convert ADC value to voltage
 174:Core/Src/cell_temp_handler.c ****     float voltage = ((float)adc_value / ADC_RESOLUTION) * ADC_VREF;
 175:Core/Src/cell_temp_handler.c ****     
 176:Core/Src/cell_temp_handler.c ****     // Check for disconnected thermistor (very low ADC reading means low voltage = open circuit)
 177:Core/Src/cell_temp_handler.c ****     if (adc_value < 10) {  // Less than ~8mV indicates disconnected sensor
 178:Core/Src/cell_temp_handler.c ****         return -127.0f;  // Return obvious error value
 179:Core/Src/cell_temp_handler.c ****     }
 180:Core/Src/cell_temp_handler.c ****     
 181:Core/Src/cell_temp_handler.c ****     // Calculate thermistor resistance using voltage divider
 182:Core/Src/cell_temp_handler.c ****     // Circuit: 3.3V -> 10kΩ pullup -> ADC_input -> Thermistor -> GND
 183:Core/Src/cell_temp_handler.c ****     // Voltage divider: V_adc = 3.3V * (R_thermistor / (R_pullup + R_thermistor))
 184:Core/Src/cell_temp_handler.c ****     // Solving for R_thermistor: R_thermistor = (V_adc * R_pullup) / (3.3V - V_adc)
 185:Core/Src/cell_temp_handler.c ****     
 186:Core/Src/cell_temp_handler.c ****     float r_thermistor;
 187:Core/Src/cell_temp_handler.c ****     
 188:Core/Src/cell_temp_handler.c ****     if (voltage >= 3.29f) {  // Close to 3.3V limit, very high resistance (cold)
 189:Core/Src/cell_temp_handler.c ****         r_thermistor = PULLUP_RESISTOR * 100.0f;  // Assume very high resistance
 190:Core/Src/cell_temp_handler.c ****     } else {
 191:Core/Src/cell_temp_handler.c ****         // Normal calculation with 3.3V supply
 192:Core/Src/cell_temp_handler.c ****         r_thermistor = (voltage * PULLUP_RESISTOR) / (ADC_VREF - voltage);
 193:Core/Src/cell_temp_handler.c ****     }
 194:Core/Src/cell_temp_handler.c ****     
 195:Core/Src/cell_temp_handler.c ****     // Handle edge cases
 196:Core/Src/cell_temp_handler.c ****     if (r_thermistor <= 0) {
 197:Core/Src/cell_temp_handler.c ****         return 125.0f; // Return maximum temperature for very low resistance
 198:Core/Src/cell_temp_handler.c ****     }
 199:Core/Src/cell_temp_handler.c ****     
 200:Core/Src/cell_temp_handler.c ****     // Calculate temperature using B-parameter equation (derived from Steinhart-Hart)
 201:Core/Src/cell_temp_handler.c ****     // 1/T = 1/T0 + (1/B) * ln(R/R0)
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccr7DEtS.s 			page 5


 202:Core/Src/cell_temp_handler.c ****     // Where T0 = 298.15K (25°C), R0 = resistance at 25°C, B = B-value
 203:Core/Src/cell_temp_handler.c ****     float ln_ratio = logf(r_thermistor / THERMISTOR_R25);
 204:Core/Src/cell_temp_handler.c ****     float temp_kelvin = 1.0f / ((1.0f / REFERENCE_TEMP_K) + (ln_ratio / THERMISTOR_B_VALUE));
 205:Core/Src/cell_temp_handler.c ****     
 206:Core/Src/cell_temp_handler.c ****     // Convert to Celsius
 207:Core/Src/cell_temp_handler.c ****     float temp_celsius = temp_kelvin - 273.15f;
 208:Core/Src/cell_temp_handler.c ****     
 209:Core/Src/cell_temp_handler.c ****     // Clamp to reasonable range
 210:Core/Src/cell_temp_handler.c ****     if (temp_celsius < -40.0f) {
 211:Core/Src/cell_temp_handler.c ****         temp_celsius = -40.0f;
 212:Core/Src/cell_temp_handler.c ****     } else if (temp_celsius > 125.0f) {
 213:Core/Src/cell_temp_handler.c ****         temp_celsius = 125.0f;
 214:Core/Src/cell_temp_handler.c ****     }
 215:Core/Src/cell_temp_handler.c ****     
 216:Core/Src/cell_temp_handler.c ****     return temp_celsius;
 217:Core/Src/cell_temp_handler.c **** }
 218:Core/Src/cell_temp_handler.c **** 
 219:Core/Src/cell_temp_handler.c **** /**
 220:Core/Src/cell_temp_handler.c ****   * @brief  Read temperature from specific thermistor
 221:Core/Src/cell_temp_handler.c ****   * @param  adc_index: ADC channel index (0-6)
 222:Core/Src/cell_temp_handler.c ****   * @param  mux_channel: MUX channel (0-7)
 223:Core/Src/cell_temp_handler.c ****   * @retval Temperature in degrees Celsius
 224:Core/Src/cell_temp_handler.c ****   */
 225:Core/Src/cell_temp_handler.c **** float CellTemp_ReadThermistor(uint8_t adc_index, uint8_t mux_channel)
 226:Core/Src/cell_temp_handler.c **** {
 227:Core/Src/cell_temp_handler.c ****     // Validate inputs
 228:Core/Src/cell_temp_handler.c ****     if (adc_index >= NUM_ADC_CHANNELS || mux_channel >= MUX_CHANNELS) {
 229:Core/Src/cell_temp_handler.c ****         return -127.0f;
 230:Core/Src/cell_temp_handler.c ****     }
 231:Core/Src/cell_temp_handler.c ****     
 232:Core/Src/cell_temp_handler.c ****     // Set MUX to desired channel
 233:Core/Src/cell_temp_handler.c ****     CellTemp_SetMuxChannel(mux_channel);
 234:Core/Src/cell_temp_handler.c ****     
 235:Core/Src/cell_temp_handler.c ****     // Read ADC value from the specified ADC channel
 236:Core/Src/cell_temp_handler.c ****     uint16_t adc_value = CellTemp_ReadADC(adc_channels[adc_index]);
 237:Core/Src/cell_temp_handler.c ****     
 238:Core/Src/cell_temp_handler.c ****     // Calculate temperature
 239:Core/Src/cell_temp_handler.c ****     return CellTemp_CalculateTemperature(adc_value);
 240:Core/Src/cell_temp_handler.c **** }
 241:Core/Src/cell_temp_handler.c **** 
 242:Core/Src/cell_temp_handler.c **** /**
 243:Core/Src/cell_temp_handler.c ****   * @brief  Main temperature monitoring task (to be called from ReadCellTemps)
 244:Core/Src/cell_temp_handler.c ****   * @param  argument: Not used
 245:Core/Src/cell_temp_handler.c ****   * @retval None
 246:Core/Src/cell_temp_handler.c ****   */
 247:Core/Src/cell_temp_handler.c **** void CellTemp_MonitorTask(void *argument)
 248:Core/Src/cell_temp_handler.c **** {
 249:Core/Src/cell_temp_handler.c ****     static uint32_t last_summary_tick = 0;
 250:Core/Src/cell_temp_handler.c ****     
 251:Core/Src/cell_temp_handler.c ****     // Initialize the temperature monitoring system
 252:Core/Src/cell_temp_handler.c ****     if (CellTemp_Init() != HAL_OK) {
 253:Core/Src/cell_temp_handler.c ****         // Handle initialization error - blink would go here if we had an LED
 254:Core/Src/cell_temp_handler.c ****         while(1) {
 255:Core/Src/cell_temp_handler.c ****             osDelay(1000);  // Wait 1 second (1000 ticks at 1ms tick rate)
 256:Core/Src/cell_temp_handler.c ****         }
 257:Core/Src/cell_temp_handler.c ****     }
 258:Core/Src/cell_temp_handler.c ****     
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccr7DEtS.s 			page 6


 259:Core/Src/cell_temp_handler.c ****     // Initialize summary message timestamp
 260:Core/Src/cell_temp_handler.c ****     last_summary_tick = osKernelGetTickCount();
 261:Core/Src/cell_temp_handler.c ****     
 262:Core/Src/cell_temp_handler.c ****     // Strategy: Oversample each MUX channel for 125ms, then send CAN updates
 263:Core/Src/cell_temp_handler.c ****     // - Set MUX channel once
 264:Core/Src/cell_temp_handler.c ****     // - Sample all 7 ADC channels every 10ms for 125ms (12 samples each)
 265:Core/Src/cell_temp_handler.c ****     // - Average the samples to get accurate readings
 266:Core/Src/cell_temp_handler.c ****     // - Send CAN messages with updated values for all 7 ADCs
 267:Core/Src/cell_temp_handler.c ****     // - Move to next MUX channel and repeat
 268:Core/Src/cell_temp_handler.c ****     // Complete cycle time: 125ms × 8 MUX channels = 1 second
 269:Core/Src/cell_temp_handler.c ****     
 270:Core/Src/cell_temp_handler.c ****     /* Infinite loop */
 271:Core/Src/cell_temp_handler.c ****     for(;;)
 272:Core/Src/cell_temp_handler.c ****     {
 273:Core/Src/cell_temp_handler.c ****         // Set the current MUX channel for all ADCs
 274:Core/Src/cell_temp_handler.c ****         CellTemp_SetMuxChannel(temp_state.current_mux);
 275:Core/Src/cell_temp_handler.c ****         
 276:Core/Src/cell_temp_handler.c ****         // Reset accumulators for this MUX channel (across all ADC channels)
 277:Core/Src/cell_temp_handler.c ****         for (uint8_t adc = 0; adc < NUM_ADC_CHANNELS; adc++) {
 278:Core/Src/cell_temp_handler.c ****             if (CellTemp_IsADCEnabled(adc)) {
 279:Core/Src/cell_temp_handler.c ****                 uint8_t therm_idx = adc * MUX_CHANNELS + temp_state.current_mux;
 280:Core/Src/cell_temp_handler.c ****                 temp_state.thermistors[therm_idx].adc_accumulator = 0;
 281:Core/Src/cell_temp_handler.c ****                 temp_state.thermistors[therm_idx].sample_count = 0;
 282:Core/Src/cell_temp_handler.c ****             }
 283:Core/Src/cell_temp_handler.c ****         }
 284:Core/Src/cell_temp_handler.c ****         
