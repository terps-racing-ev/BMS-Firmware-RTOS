 102:Core/Src/cell_temp_handler.c ****   */
 103:Core/Src/cell_temp_handler.c **** uint16_t CellTemp_ReadADC(uint32_t adc_channel)
 104:Core/Src/cell_temp_handler.c **** {
 105:Core/Src/cell_temp_handler.c ****     uint16_t adc_value = 0;
 106:Core/Src/cell_temp_handler.c ****     
 107:Core/Src/cell_temp_handler.c ****     // Configure ADC for the specified channel
 108:Core/Src/cell_temp_handler.c ****     if (CellTemp_ConfigureADCChannel(adc_channel) != HAL_OK) {
 109:Core/Src/cell_temp_handler.c ****         return 0;
 110:Core/Src/cell_temp_handler.c ****     }
 111:Core/Src/cell_temp_handler.c ****     
 112:Core/Src/cell_temp_handler.c ****     // Start ADC conversion
 113:Core/Src/cell_temp_handler.c ****     if (HAL_ADC_Start(&hadc1) == HAL_OK) {
 114:Core/Src/cell_temp_handler.c ****         // Wait for conversion to complete
 115:Core/Src/cell_temp_handler.c ****         if (HAL_ADC_PollForConversion(&hadc1, HAL_MAX_DELAY) == HAL_OK) {
 116:Core/Src/cell_temp_handler.c ****             // Get ADC value
 117:Core/Src/cell_temp_handler.c ****             adc_value = HAL_ADC_GetValue(&hadc1);
 118:Core/Src/cell_temp_handler.c ****         }
 119:Core/Src/cell_temp_handler.c ****         // Stop ADC
 120:Core/Src/cell_temp_handler.c ****         HAL_ADC_Stop(&hadc1);
 121:Core/Src/cell_temp_handler.c ****     }
 122:Core/Src/cell_temp_handler.c ****     
 123:Core/Src/cell_temp_handler.c ****     return adc_value;
 124:Core/Src/cell_temp_handler.c **** }
