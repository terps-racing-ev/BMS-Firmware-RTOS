 294:Core/Src/cell_temp_handler.c ****                 }
 295:Core/Src/cell_temp_handler.c ****             }
 296:Core/Src/cell_temp_handler.c ****             
 297:Core/Src/cell_temp_handler.c ****             // Wait 10ms before next sample
 298:Core/Src/cell_temp_handler.c ****             osDelay(TEMP_SAMPLE_INTERVAL_MS);
 299:Core/Src/cell_temp_handler.c ****         }
 300:Core/Src/cell_temp_handler.c ****         
 301:Core/Src/cell_temp_handler.c ****         // Calculate averaged values and temperatures for this MUX channel
 302:Core/Src/cell_temp_handler.c ****         uint32_t current_time = osKernelGetTickCount();
 303:Core/Src/cell_temp_handler.c ****         
 304:Core/Src/cell_temp_handler.c ****         for (uint8_t adc = 0; adc < NUM_ADC_CHANNELS; adc++) {
 305:Core/Src/cell_temp_handler.c ****             if (CellTemp_IsADCEnabled(adc)) {
 306:Core/Src/cell_temp_handler.c ****                 uint8_t therm_idx = adc * MUX_CHANNELS + temp_state.current_mux;
 307:Core/Src/cell_temp_handler.c ****                 thermistor_data_t *therm = &temp_state.thermistors[therm_idx];
 308:Core/Src/cell_temp_handler.c ****                 
 309:Core/Src/cell_temp_handler.c ****                 // Calculate average ADC value
 310:Core/Src/cell_temp_handler.c ****                 if (therm->sample_count > 0) {
 311:Core/Src/cell_temp_handler.c ****                     therm->raw_adc = (uint16_t)(therm->adc_accumulator / therm->sample_count);
 312:Core/Src/cell_temp_handler.c ****                     therm->temperature = CellTemp_CalculateTemperature(therm->raw_adc);
 313:Core/Src/cell_temp_handler.c ****                     therm->last_read_time = current_time;
 314:Core/Src/cell_temp_handler.c ****                     
