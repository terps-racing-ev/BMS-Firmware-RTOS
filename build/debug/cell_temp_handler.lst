 403:Core/Src/cell_temp_handler.c ****                 }
 404:Core/Src/cell_temp_handler.c ****             }
 405:Core/Src/cell_temp_handler.c ****             
 406:Core/Src/cell_temp_handler.c ****             // Set/clear error flags based on counts vs threshold
