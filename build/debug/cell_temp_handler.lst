 343:Core/Src/cell_temp_handler.c ****         
 344:Core/Src/cell_temp_handler.c ****         // Send CAN messages only when all 4 thermistors in the message have been updated
 345:Core/Src/cell_temp_handler.c ****         // Each message covers 4 consecutive thermistors from the same ADC
 346:Core/Src/cell_temp_handler.c ****         // Message updates happen when MUX channels 3 and 7 complete
 347:Core/Src/cell_temp_handler.c ****         
 348:Core/Src/cell_temp_handler.c ****         if (temp_state.current_mux == 3 || temp_state.current_mux == 7) {
 349:Core/Src/cell_temp_handler.c ****             // Just completed MUX 0-3 or MUX 4-7, so we have all 4 temps for a message
 350:Core/Src/cell_temp_handler.c ****             for (uint8_t adc = 0; adc < NUM_ADC_CHANNELS; adc++) {
 351:Core/Src/cell_temp_handler.c ****                 if (CellTemp_IsADCEnabled(adc)) {
