 126:Core/Src/cell_temp_handler.c **** /**
 127:Core/Src/cell_temp_handler.c ****   * @brief  Set MUX channel using 3-bit digital control signals
 128:Core/Src/cell_temp_handler.c ****   * @param  channel: MUX channel to select (0-7)
 129:Core/Src/cell_temp_handler.c ****   * @retval None
 130:Core/Src/cell_temp_handler.c ****   */
 131:Core/Src/cell_temp_handler.c **** void CellTemp_SetMuxChannel(uint8_t channel)
 132:Core/Src/cell_temp_handler.c **** {
 133:Core/Src/cell_temp_handler.c ****     // Validate channel range
 134:Core/Src/cell_temp_handler.c ****     if (channel > 7) {
 135:Core/Src/cell_temp_handler.c ****         return;
 136:Core/Src/cell_temp_handler.c ****     }
 137:Core/Src/cell_temp_handler.c ****     
 138:Core/Src/cell_temp_handler.c ****     // Set MUX control signals based on 3-bit channel value
 139:Core/Src/cell_temp_handler.c ****     // MUX_SIG1 = bit 0
 140:Core/Src/cell_temp_handler.c ****     // MUX_SIG2 = bit 1  
 141:Core/Src/cell_temp_handler.c ****     // MUX_SIG3 = bit 2
 142:Core/Src/cell_temp_handler.c ****     
 143:Core/Src/cell_temp_handler.c ****     if (channel & 0x01) {
 144:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG1_PORT, MUX_SIG1_PIN, GPIO_PIN_SET);
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccCRlvGh.s 			page 4


 145:Core/Src/cell_temp_handler.c ****     } else {
 146:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG1_PORT, MUX_SIG1_PIN, GPIO_PIN_RESET);
 147:Core/Src/cell_temp_handler.c ****     }
 148:Core/Src/cell_temp_handler.c ****     
 149:Core/Src/cell_temp_handler.c ****     if (channel & 0x02) {
 150:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG2_PORT, MUX_SIG2_PIN, GPIO_PIN_SET);
 151:Core/Src/cell_temp_handler.c ****     } else {
 152:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG2_PORT, MUX_SIG2_PIN, GPIO_PIN_RESET);
 153:Core/Src/cell_temp_handler.c ****     }
 154:Core/Src/cell_temp_handler.c ****     
 155:Core/Src/cell_temp_handler.c ****     if (channel & 0x04) {
 156:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG3_PORT, MUX_SIG3_PIN, GPIO_PIN_SET);
 157:Core/Src/cell_temp_handler.c ****     } else {
 158:Core/Src/cell_temp_handler.c ****         HAL_GPIO_WritePin(MUX_SIG3_PORT, MUX_SIG3_PIN, GPIO_PIN_RESET);
 159:Core/Src/cell_temp_handler.c ****     }
 160:Core/Src/cell_temp_handler.c ****     
 161:Core/Src/cell_temp_handler.c ****     // Allow time for MUX to settle (2 ticks = 2ms at default 1ms tick rate)
 162:Core/Src/cell_temp_handler.c ****     osDelay(2);
 163:Core/Src/cell_temp_handler.c **** }
