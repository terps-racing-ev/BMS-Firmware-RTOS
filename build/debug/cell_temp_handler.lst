 101:Core/Src/cell_temp_handler.c ****   */
 102:Core/Src/cell_temp_handler.c **** uint16_t CellTemp_ReadADC(uint32_t adc_channel)
 103:Core/Src/cell_temp_handler.c **** {
 104:Core/Src/cell_temp_handler.c ****     uint16_t adc_value = 0;
 105:Core/Src/cell_temp_handler.c ****     
 106:Core/Src/cell_temp_handler.c ****     // Configure ADC for the specified channel
 107:Core/Src/cell_temp_handler.c ****     if (CellTemp_ConfigureADCChannel(adc_channel) != HAL_OK) {
 108:Core/Src/cell_temp_handler.c ****         return 0;
