 329:Core/Src/cell_temp_handler.c ****                     therm->raw_adc = 0;
 330:Core/Src/cell_temp_handler.c ****                     therm->temperature = -127.0f;
 331:Core/Src/cell_temp_handler.c ****                     // Only report sensor fault if fault detection is enabled for this thermistor
 332:Core/Src/cell_temp_handler.c ****                     if (CellTemp_IsFaultDetectionEnabled(therm_idx)) {
 333:Core/Src/cell_temp_handler.c ****                         ErrorMgr_SetError(ERROR_TEMP_SENSOR_FAULT);
 334:Core/Src/cell_temp_handler.c ****                     }
 335:Core/Src/cell_temp_handler.c ****                 }
 336:Core/Src/cell_temp_handler.c ****             } else {
 337:Core/Src/cell_temp_handler.c ****                 // ADC disabled - mark thermistor as invalid
