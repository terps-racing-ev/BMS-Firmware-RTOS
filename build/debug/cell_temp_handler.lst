  49:Core/Src/cell_temp_handler.c **** /**
  50:Core/Src/cell_temp_handler.c ****   * @brief  Initialize cell temperature monitoring system
  51:Core/Src/cell_temp_handler.c ****   * @retval HAL_StatusTypeDef
  52:Core/Src/cell_temp_handler.c ****   */
  53:Core/Src/cell_temp_handler.c **** HAL_StatusTypeDef CellTemp_Init(void)
  54:Core/Src/cell_temp_handler.c **** {
  55:Core/Src/cell_temp_handler.c ****     // Initialize state structure
  56:Core/Src/cell_temp_handler.c ****     memset(&temp_state, 0, sizeof(temp_monitor_state_t));
  57:Core/Src/cell_temp_handler.c **** 
  58:Core/Src/cell_temp_handler.c ****     // Initialize thermistor data
  59:Core/Src/cell_temp_handler.c ****     for (uint8_t i = 0; i < TOTAL_THERMISTORS; i++) {
  60:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].adc_index = i / MUX_CHANNELS;
  61:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].mux_channel = i % MUX_CHANNELS;
  62:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].temperature = -127.0f; // Invalid temperature marker
  63:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].raw_adc = 0;
  64:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].last_read_time = 0;
  65:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].adc_accumulator = 0;
  66:Core/Src/cell_temp_handler.c ****         temp_state.thermistors[i].sample_count = 0;
  67:Core/Src/cell_temp_handler.c ****     }
  68:Core/Src/cell_temp_handler.c **** 
  69:Core/Src/cell_temp_handler.c ****     // Note: ADC calibration is already done in main() before RTOS starts
  70:Core/Src/cell_temp_handler.c **** 
  71:Core/Src/cell_temp_handler.c ****     // Initialize MUX control signals to 0 (without calling osDelay)
  72:Core/Src/cell_temp_handler.c ****     HAL_GPIO_WritePin(MUX_SIG1_PORT, MUX_SIG1_PIN, GPIO_PIN_RESET);
  73:Core/Src/cell_temp_handler.c ****     HAL_GPIO_WritePin(MUX_SIG2_PORT, MUX_SIG2_PIN, GPIO_PIN_RESET);
  74:Core/Src/cell_temp_handler.c ****     HAL_GPIO_WritePin(MUX_SIG3_PORT, MUX_SIG3_PIN, GPIO_PIN_RESET);
  75:Core/Src/cell_temp_handler.c **** 
  76:Core/Src/cell_temp_handler.c ****     return HAL_OK;
  77:Core/Src/cell_temp_handler.c **** }
