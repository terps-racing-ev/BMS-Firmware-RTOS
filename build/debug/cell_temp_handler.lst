 284:Core/Src/cell_temp_handler.c ****                     thermistor_data_t *therm = &temp_state.thermistors[therm_idx];
 285:Core/Src/cell_temp_handler.c ****                     
 286:Core/Src/cell_temp_handler.c ****                     // Read ADC value
 287:Core/Src/cell_temp_handler.c ****                     uint16_t adc_value = CellTemp_ReadADC(adc_channels[adc]);
 288:Core/Src/cell_temp_handler.c ****                     
 289:Core/Src/cell_temp_handler.c ****                     // Accumulate sample (ignore obviously invalid readings)
 290:Core/Src/cell_temp_handler.c ****                     if (adc_value >= 10) {  // Valid reading threshold
