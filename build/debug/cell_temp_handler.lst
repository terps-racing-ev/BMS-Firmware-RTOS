 110:Core/Src/cell_temp_handler.c ****     
 111:Core/Src/cell_temp_handler.c ****     // Start ADC conversion
 112:Core/Src/cell_temp_handler.c ****     if (HAL_ADC_Start(&hadc1) == HAL_OK) {
 113:Core/Src/cell_temp_handler.c ****         // Wait for conversion to complete
 114:Core/Src/cell_temp_handler.c ****         if (HAL_ADC_PollForConversion(&hadc1, HAL_MAX_DELAY) == HAL_OK) {
 115:Core/Src/cell_temp_handler.c ****             // Get ADC value
 116:Core/Src/cell_temp_handler.c ****             adc_value = HAL_ADC_GetValue(&hadc1);
 117:Core/Src/cell_temp_handler.c ****         }
 118:Core/Src/cell_temp_handler.c ****         // Stop ADC
 119:Core/Src/cell_temp_handler.c ****         HAL_ADC_Stop(&hadc1);
 120:Core/Src/cell_temp_handler.c ****     }
 121:Core/Src/cell_temp_handler.c ****     
 122:Core/Src/cell_temp_handler.c ****     return adc_value;
 123:Core/Src/cell_temp_handler.c **** }
