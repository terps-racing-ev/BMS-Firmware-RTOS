 306:Core/Src/cell_temp_handler.c ****         }
 307:Core/Src/cell_temp_handler.c ****         
 308:Core/Src/cell_temp_handler.c ****         // Calculate averaged values and temperatures for this MUX channel
 309:Core/Src/cell_temp_handler.c ****         uint32_t current_time = osKernelGetTickCount();
 310:Core/Src/cell_temp_handler.c ****         
 311:Core/Src/cell_temp_handler.c ****         for (uint8_t adc = 0; adc < NUM_ADC_CHANNELS; adc++) {
 312:Core/Src/cell_temp_handler.c ****             if (CellTemp_IsADCEnabled(adc)) {
