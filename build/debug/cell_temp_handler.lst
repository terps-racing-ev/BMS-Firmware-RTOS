 165:Core/Src/cell_temp_handler.c **** /**
 166:Core/Src/cell_temp_handler.c ****   * @brief  Calculate temperature from thermistor ADC reading using B-parameter equation
 167:Core/Src/cell_temp_handler.c ****   * @param  adc_value: Raw ADC value (0-4095)
 168:Core/Src/cell_temp_handler.c ****   * @retval Temperature in degrees Celsius
 169:Core/Src/cell_temp_handler.c ****   */
 170:Core/Src/cell_temp_handler.c **** float CellTemp_CalculateTemperature(uint16_t adc_value)
 171:Core/Src/cell_temp_handler.c **** {
 172:Core/Src/cell_temp_handler.c ****     // Convert ADC value to voltage
 173:Core/Src/cell_temp_handler.c ****     float voltage = ((float)adc_value / ADC_RESOLUTION) * ADC_VREF;
 174:Core/Src/cell_temp_handler.c ****     
 175:Core/Src/cell_temp_handler.c ****     // Check for disconnected thermistor (very low ADC reading means low voltage = open circuit)
 176:Core/Src/cell_temp_handler.c ****     if (adc_value < 10) {  // Less than ~8mV indicates disconnected sensor
 177:Core/Src/cell_temp_handler.c ****         return -127.0f;  // Return obvious error value
 178:Core/Src/cell_temp_handler.c ****     }
 179:Core/Src/cell_temp_handler.c ****     
 180:Core/Src/cell_temp_handler.c ****     // Calculate thermistor resistance using voltage divider
 181:Core/Src/cell_temp_handler.c ****     // Circuit: 3.3V -> 10kΩ pullup -> ADC_input -> Thermistor -> GND
 182:Core/Src/cell_temp_handler.c ****     // Voltage divider: V_adc = 3.3V * (R_thermistor / (R_pullup + R_thermistor))
 183:Core/Src/cell_temp_handler.c ****     // Solving for R_thermistor: R_thermistor = (V_adc * R_pullup) / (3.3V - V_adc)
 184:Core/Src/cell_temp_handler.c ****     
 185:Core/Src/cell_temp_handler.c ****     float r_thermistor;
 186:Core/Src/cell_temp_handler.c ****     
 187:Core/Src/cell_temp_handler.c ****     if (voltage >= 3.29f) {  // Close to 3.3V limit, very high resistance (cold)
 188:Core/Src/cell_temp_handler.c ****         r_thermistor = PULLUP_RESISTOR * 100.0f;  // Assume very high resistance
 189:Core/Src/cell_temp_handler.c ****     } else {
 190:Core/Src/cell_temp_handler.c ****         // Normal calculation with 3.3V supply
 191:Core/Src/cell_temp_handler.c ****         r_thermistor = (voltage * PULLUP_RESISTOR) / (ADC_VREF - voltage);
 192:Core/Src/cell_temp_handler.c ****     }
 193:Core/Src/cell_temp_handler.c ****     
 194:Core/Src/cell_temp_handler.c ****     // Handle edge cases
 195:Core/Src/cell_temp_handler.c ****     if (r_thermistor <= 0) {
 196:Core/Src/cell_temp_handler.c ****         return 125.0f; // Return maximum temperature for very low resistance
 197:Core/Src/cell_temp_handler.c ****     }
 198:Core/Src/cell_temp_handler.c ****     
 199:Core/Src/cell_temp_handler.c ****     // Calculate temperature using B-parameter equation (derived from Steinhart-Hart)
 200:Core/Src/cell_temp_handler.c ****     // 1/T = 1/T0 + (1/B) * ln(R/R0)
 201:Core/Src/cell_temp_handler.c ****     // Where T0 = 298.15K (25°C), R0 = resistance at 25°C, B = B-value
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccCRlvGh.s 			page 5


 202:Core/Src/cell_temp_handler.c ****     float ln_ratio = logf(r_thermistor / THERMISTOR_R25);
 203:Core/Src/cell_temp_handler.c ****     float temp_kelvin = 1.0f / ((1.0f / REFERENCE_TEMP_K) + (ln_ratio / THERMISTOR_B_VALUE));
 204:Core/Src/cell_temp_handler.c ****     
 205:Core/Src/cell_temp_handler.c ****     // Convert to Celsius
 206:Core/Src/cell_temp_handler.c ****     float temp_celsius = temp_kelvin - 273.15f;
 207:Core/Src/cell_temp_handler.c ****     
 208:Core/Src/cell_temp_handler.c ****     // Clamp to reasonable range
 209:Core/Src/cell_temp_handler.c ****     if (temp_celsius < -40.0f) {
 210:Core/Src/cell_temp_handler.c ****         temp_celsius = -40.0f;
 211:Core/Src/cell_temp_handler.c ****     } else if (temp_celsius > 125.0f) {
 212:Core/Src/cell_temp_handler.c ****         temp_celsius = 125.0f;
 213:Core/Src/cell_temp_handler.c ****     }
 214:Core/Src/cell_temp_handler.c ****     
 215:Core/Src/cell_temp_handler.c ****     return temp_celsius;
 216:Core/Src/cell_temp_handler.c **** }
 217:Core/Src/cell_temp_handler.c **** 
 218:Core/Src/cell_temp_handler.c **** /**
 219:Core/Src/cell_temp_handler.c ****   * @brief  Read temperature from specific thermistor
 220:Core/Src/cell_temp_handler.c ****   * @param  adc_index: ADC channel index (0-6)
 221:Core/Src/cell_temp_handler.c ****   * @param  mux_channel: MUX channel (0-7)
 222:Core/Src/cell_temp_handler.c ****   * @retval Temperature in degrees Celsius
 223:Core/Src/cell_temp_handler.c ****   */
 224:Core/Src/cell_temp_handler.c **** float CellTemp_ReadThermistor(uint8_t adc_index, uint8_t mux_channel)
 225:Core/Src/cell_temp_handler.c **** {
 226:Core/Src/cell_temp_handler.c ****     // Validate inputs
 227:Core/Src/cell_temp_handler.c ****     if (adc_index >= NUM_ADC_CHANNELS || mux_channel >= MUX_CHANNELS) {
 228:Core/Src/cell_temp_handler.c ****         return -127.0f;
 229:Core/Src/cell_temp_handler.c ****     }
 230:Core/Src/cell_temp_handler.c ****     
 231:Core/Src/cell_temp_handler.c ****     // Set MUX to desired channel
 232:Core/Src/cell_temp_handler.c ****     CellTemp_SetMuxChannel(mux_channel);
 233:Core/Src/cell_temp_handler.c ****     
 234:Core/Src/cell_temp_handler.c ****     // Read ADC value from the specified ADC channel
 235:Core/Src/cell_temp_handler.c ****     uint16_t adc_value = CellTemp_ReadADC(adc_channels[adc_index]);
 236:Core/Src/cell_temp_handler.c ****     
 237:Core/Src/cell_temp_handler.c ****     // Calculate temperature
 238:Core/Src/cell_temp_handler.c ****     return CellTemp_CalculateTemperature(adc_value);
 239:Core/Src/cell_temp_handler.c **** }
 240:Core/Src/cell_temp_handler.c **** 
 241:Core/Src/cell_temp_handler.c **** /**
 242:Core/Src/cell_temp_handler.c ****   * @brief  Main temperature monitoring task (to be called from ReadCellTemps)
 243:Core/Src/cell_temp_handler.c ****   * @param  argument: Not used
 244:Core/Src/cell_temp_handler.c ****   * @retval None
 245:Core/Src/cell_temp_handler.c ****   */
 246:Core/Src/cell_temp_handler.c **** void CellTemp_MonitorTask(void *argument)
 247:Core/Src/cell_temp_handler.c **** {
 248:Core/Src/cell_temp_handler.c ****     static uint32_t last_summary_tick = 0;
 249:Core/Src/cell_temp_handler.c ****     
 250:Core/Src/cell_temp_handler.c ****     // Initialize the temperature monitoring system
 251:Core/Src/cell_temp_handler.c ****     if (CellTemp_Init() != HAL_OK) {
 252:Core/Src/cell_temp_handler.c ****         // Handle initialization error - blink would go here if we had an LED
 253:Core/Src/cell_temp_handler.c ****         while(1) {
 254:Core/Src/cell_temp_handler.c ****             osDelay(1000);  // Wait 1 second (1000 ticks at 1ms tick rate)
 255:Core/Src/cell_temp_handler.c ****         }
 256:Core/Src/cell_temp_handler.c ****     }
 257:Core/Src/cell_temp_handler.c ****     
 258:Core/Src/cell_temp_handler.c ****     // Initialize summary message timestamp
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccCRlvGh.s 			page 6


 259:Core/Src/cell_temp_handler.c ****     last_summary_tick = osKernelGetTickCount();
 260:Core/Src/cell_temp_handler.c ****     
 261:Core/Src/cell_temp_handler.c ****     // Strategy: Oversample each MUX channel for 125ms, then send CAN updates
 262:Core/Src/cell_temp_handler.c ****     // - Set MUX channel once
 263:Core/Src/cell_temp_handler.c ****     // - Sample all 7 ADC channels every 10ms for 125ms (12 samples each)
 264:Core/Src/cell_temp_handler.c ****     // - Average the samples to get accurate readings
 265:Core/Src/cell_temp_handler.c ****     // - Send CAN messages with updated values for all 7 ADCs
 266:Core/Src/cell_temp_handler.c ****     // - Move to next MUX channel and repeat
 267:Core/Src/cell_temp_handler.c ****     // Complete cycle time: 125ms × 8 MUX channels = 1 second
 268:Core/Src/cell_temp_handler.c ****     
 269:Core/Src/cell_temp_handler.c ****     /* Infinite loop */
 270:Core/Src/cell_temp_handler.c ****     for(;;)
 271:Core/Src/cell_temp_handler.c ****     {
 272:Core/Src/cell_temp_handler.c ****         // Set the current MUX channel for all ADCs
 273:Core/Src/cell_temp_handler.c ****         CellTemp_SetMuxChannel(temp_state.current_mux);
 274:Core/Src/cell_temp_handler.c ****         
 275:Core/Src/cell_temp_handler.c ****         // Reset accumulators for this MUX channel (across all ADC channels)
 276:Core/Src/cell_temp_handler.c ****         for (uint8_t adc = 0; adc < NUM_ADC_CHANNELS; adc++) {
 277:Core/Src/cell_temp_handler.c ****             if (CellTemp_IsADCEnabled(adc)) {
 278:Core/Src/cell_temp_handler.c ****                 uint8_t therm_idx = adc * MUX_CHANNELS + temp_state.current_mux;
 279:Core/Src/cell_temp_handler.c ****                 temp_state.thermistors[therm_idx].adc_accumulator = 0;
 280:Core/Src/cell_temp_handler.c ****                 temp_state.thermistors[therm_idx].sample_count = 0;
 281:Core/Src/cell_temp_handler.c ****             }
 282:Core/Src/cell_temp_handler.c ****         }
 283:Core/Src/cell_temp_handler.c ****         
 284:Core/Src/cell_temp_handler.c ****         // Oversample for 500ms (50 samples at 10ms intervals)
 285:Core/Src/cell_temp_handler.c ****         for (uint16_t sample = 0; sample < TEMP_SAMPLES_PER_MUX; sample++) {
 286:Core/Src/cell_temp_handler.c ****             // Read all enabled ADC channels for current MUX channel
 287:Core/Src/cell_temp_handler.c ****             for (uint8_t adc = 0; adc < NUM_ADC_CHANNELS; adc++) {
 288:Core/Src/cell_temp_handler.c ****                 if (CellTemp_IsADCEnabled(adc)) {
 289:Core/Src/cell_temp_handler.c ****                     uint8_t therm_idx = adc * MUX_CHANNELS + temp_state.current_mux;
 290:Core/Src/cell_temp_handler.c ****                     thermistor_data_t *therm = &temp_state.thermistors[therm_idx];
 291:Core/Src/cell_temp_handler.c ****                     
 292:Core/Src/cell_temp_handler.c ****                     // Read ADC value
 293:Core/Src/cell_temp_handler.c ****                     uint16_t adc_value = CellTemp_ReadADC(adc_channels[adc]);
 294:Core/Src/cell_temp_handler.c ****                     
 295:Core/Src/cell_temp_handler.c ****                     // Accumulate sample (ignore obviously invalid readings)
 296:Core/Src/cell_temp_handler.c ****                     if (adc_value >= 10) {  // Valid reading threshold
 297:Core/Src/cell_temp_handler.c ****                         therm->adc_accumulator += adc_value;
 298:Core/Src/cell_temp_handler.c ****                         therm->sample_count++;
 299:Core/Src/cell_temp_handler.c ****                     }
 300:Core/Src/cell_temp_handler.c ****                 }
 301:Core/Src/cell_temp_handler.c ****             }
 302:Core/Src/cell_temp_handler.c ****             
 303:Core/Src/cell_temp_handler.c ****             // Wait 10ms before next sample
 304:Core/Src/cell_temp_handler.c ****             osDelay(TEMP_SAMPLE_INTERVAL_MS);
 305:Core/Src/cell_temp_handler.c ****         }
 306:Core/Src/cell_temp_handler.c ****         
 307:Core/Src/cell_temp_handler.c ****         // Calculate averaged values and temperatures for this MUX channel
 308:Core/Src/cell_temp_handler.c ****         uint32_t current_time = osKernelGetTickCount();
 309:Core/Src/cell_temp_handler.c ****         
 310:Core/Src/cell_temp_handler.c ****         for (uint8_t adc = 0; adc < NUM_ADC_CHANNELS; adc++) {
 311:Core/Src/cell_temp_handler.c ****             if (CellTemp_IsADCEnabled(adc)) {
 312:Core/Src/cell_temp_handler.c ****                 uint8_t therm_idx = adc * MUX_CHANNELS + temp_state.current_mux;
 313:Core/Src/cell_temp_handler.c ****                 thermistor_data_t *therm = &temp_state.thermistors[therm_idx];
 314:Core/Src/cell_temp_handler.c ****                 
 315:Core/Src/cell_temp_handler.c ****                 // Calculate average ADC value
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccCRlvGh.s 			page 7


 316:Core/Src/cell_temp_handler.c ****                 if (therm->sample_count > 0) {
 317:Core/Src/cell_temp_handler.c ****                     therm->raw_adc = (uint16_t)(therm->adc_accumulator / therm->sample_count);
 318:Core/Src/cell_temp_handler.c ****                     therm->temperature = CellTemp_CalculateTemperature(therm->raw_adc);
 319:Core/Src/cell_temp_handler.c ****                     therm->last_read_time = current_time;
 320:Core/Src/cell_temp_handler.c ****                     
 321:Core/Src/cell_temp_handler.c ****                     // Check over-temperature immediately (only if fault detection is enabled for t
 322:Core/Src/cell_temp_handler.c ****                     // Sensor faults and under-temp are counted and checked at end of cycle against
 323:Core/Src/cell_temp_handler.c ****                     if (CellTemp_IsFaultDetectionEnabled(therm_idx)) {
 324:Core/Src/cell_temp_handler.c ****                         if (therm->temperature > -126.0f) {  // Valid temperature reading
 325:Core/Src/cell_temp_handler.c ****                             if (therm->temperature > temp_max_threshold) {
 326:Core/Src/cell_temp_handler.c ****                                 ErrorMgr_SetError(ERROR_OVER_TEMP);
 327:Core/Src/cell_temp_handler.c ****                             }
 328:Core/Src/cell_temp_handler.c ****                             // Under-temp checked at end of cycle with fault count threshold
 329:Core/Src/cell_temp_handler.c ****                         }
 330:Core/Src/cell_temp_handler.c ****                         // Sensor fault checked at end of cycle with fault count threshold
 331:Core/Src/cell_temp_handler.c ****                     }
 332:Core/Src/cell_temp_handler.c ****                 } else {
 333:Core/Src/cell_temp_handler.c ****                     // No valid samples collected - sensor fault
 334:Core/Src/cell_temp_handler.c ****                     therm->raw_adc = 0;
 335:Core/Src/cell_temp_handler.c ****                     therm->temperature = -127.0f;
 336:Core/Src/cell_temp_handler.c ****                     // Sensor fault checked at end of cycle with fault count threshold
 337:Core/Src/cell_temp_handler.c ****                 }
 338:Core/Src/cell_temp_handler.c ****             } else {
 339:Core/Src/cell_temp_handler.c ****                 // ADC disabled - mark thermistor as invalid
 340:Core/Src/cell_temp_handler.c ****                 uint8_t therm_idx = adc * MUX_CHANNELS + temp_state.current_mux;
 341:Core/Src/cell_temp_handler.c ****                 temp_state.thermistors[therm_idx].temperature = -127.0f;
 342:Core/Src/cell_temp_handler.c ****                 temp_state.thermistors[therm_idx].raw_adc = 0;
 343:Core/Src/cell_temp_handler.c ****             }
 344:Core/Src/cell_temp_handler.c ****         }
 345:Core/Src/cell_temp_handler.c ****         
 346:Core/Src/cell_temp_handler.c ****         // Send CAN messages only when all 4 thermistors in the message have been updated
 347:Core/Src/cell_temp_handler.c ****         // Each message covers 4 consecutive thermistors from the same ADC
 348:Core/Src/cell_temp_handler.c ****         // Message updates happen when MUX channels 3 and 7 complete
 349:Core/Src/cell_temp_handler.c ****         
 350:Core/Src/cell_temp_handler.c ****         if (temp_state.current_mux == 3 || temp_state.current_mux == 7) {
 351:Core/Src/cell_temp_handler.c ****             // Just completed MUX 0-3 or MUX 4-7, so we have all 4 temps for a message
 352:Core/Src/cell_temp_handler.c ****             for (uint8_t adc = 0; adc < NUM_ADC_CHANNELS; adc++) {
 353:Core/Src/cell_temp_handler.c ****                 if (CellTemp_IsADCEnabled(adc)) {
 354:Core/Src/cell_temp_handler.c ****                     // Determine which message to send based on current MUX
 355:Core/Src/cell_temp_handler.c ****                     if (temp_state.current_mux == 3) {
 356:Core/Src/cell_temp_handler.c ****                         // Send message 0 for this ADC (thermistors 0-3)
 357:Core/Src/cell_temp_handler.c ****                         uint8_t msg_idx = adc * 2;
 358:Core/Src/cell_temp_handler.c ****                         uint8_t start_therm_idx = adc * MUX_CHANNELS;
 359:Core/Src/cell_temp_handler.c ****                         CellTemp_SendTemperatureMessage(msg_idx, start_therm_idx);
 360:Core/Src/cell_temp_handler.c ****                         osDelay(2); // Small delay between messages
 361:Core/Src/cell_temp_handler.c ****                     } else {
 362:Core/Src/cell_temp_handler.c ****                         // Send message 1 for this ADC (thermistors 4-7)
 363:Core/Src/cell_temp_handler.c ****                         uint8_t msg_idx = adc * 2 + 1;
 364:Core/Src/cell_temp_handler.c ****                         uint8_t start_therm_idx = adc * MUX_CHANNELS + 4;
 365:Core/Src/cell_temp_handler.c ****                         CellTemp_SendTemperatureMessage(msg_idx, start_therm_idx);
 366:Core/Src/cell_temp_handler.c ****                         osDelay(2); // Small delay between messages
 367:Core/Src/cell_temp_handler.c ****                     }
 368:Core/Src/cell_temp_handler.c ****                 }
 369:Core/Src/cell_temp_handler.c ****             }
 370:Core/Src/cell_temp_handler.c ****         }
 371:Core/Src/cell_temp_handler.c ****         
 372:Core/Src/cell_temp_handler.c ****         // Move to next MUX channel
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccCRlvGh.s 			page 8


 373:Core/Src/cell_temp_handler.c ****         temp_state.current_mux++;
 374:Core/Src/cell_temp_handler.c ****         
 375:Core/Src/cell_temp_handler.c ****         // Check if we completed full cycle of all MUX channels
 376:Core/Src/cell_temp_handler.c ****         if (temp_state.current_mux >= MUX_CHANNELS) {
 377:Core/Src/cell_temp_handler.c ****             temp_state.current_mux = 0;
 378:Core/Src/cell_temp_handler.c ****             temp_state.cycle_count++;
 379:Core/Src/cell_temp_handler.c ****             
 380:Core/Src/cell_temp_handler.c ****             // After completing a full cycle, check if all thermistors are within limits
 381:Core/Src/cell_temp_handler.c ****             // If so, clear the error flags
 382:Core/Src/cell_temp_handler.c ****             uint8_t any_over_temp = 0;
 383:Core/Src/cell_temp_handler.c ****             uint8_t sensor_fault_count = 0;   // Count of faulty/under-temp thermistors
 384:Core/Src/cell_temp_handler.c ****             uint8_t under_temp_count = 0;
 385:Core/Src/cell_temp_handler.c ****             
 386:Core/Src/cell_temp_handler.c ****             for (uint8_t i = 0; i < TOTAL_THERMISTORS; i++) {
 387:Core/Src/cell_temp_handler.c ****                 // Only check enabled ADC channels and thermistors with fault detection enabled
 388:Core/Src/cell_temp_handler.c ****                 uint8_t therm_adc = i / MUX_CHANNELS;
 389:Core/Src/cell_temp_handler.c ****                 if (CellTemp_IsADCEnabled(therm_adc) && CellTemp_IsFaultDetectionEnabled(i)) {
 390:Core/Src/cell_temp_handler.c ****                     float temp = temp_state.thermistors[i].temperature;
 391:Core/Src/cell_temp_handler.c ****                     
 392:Core/Src/cell_temp_handler.c ****                     if (temp <= -126.0f) {
 393:Core/Src/cell_temp_handler.c ****                         // Invalid reading - sensor fault
 394:Core/Src/cell_temp_handler.c ****                         sensor_fault_count++;
 395:Core/Src/cell_temp_handler.c ****                     } else if (temp > temp_max_threshold) {
 396:Core/Src/cell_temp_handler.c ****                         // Over temperature - always flag immediately
 397:Core/Src/cell_temp_handler.c ****                         any_over_temp = 1;
 398:Core/Src/cell_temp_handler.c ****                     } else if (temp < TEMP_MIN_CELSIUS) {
 399:Core/Src/cell_temp_handler.c ****                         // Under temperature - count towards threshold
 400:Core/Src/cell_temp_handler.c ****                         under_temp_count++;
 401:Core/Src/cell_temp_handler.c ****                     }
 402:Core/Src/cell_temp_handler.c ****                 }
 403:Core/Src/cell_temp_handler.c ****             }
 404:Core/Src/cell_temp_handler.c ****             
 405:Core/Src/cell_temp_handler.c ****             // Set/clear error flags based on counts vs threshold
 406:Core/Src/cell_temp_handler.c ****             // Over-temp: any single over-temp is an error
 407:Core/Src/cell_temp_handler.c ****             if (!any_over_temp) {
 408:Core/Src/cell_temp_handler.c ****                 ErrorMgr_ClearError(ERROR_OVER_TEMP);
 409:Core/Src/cell_temp_handler.c ****             }
 410:Core/Src/cell_temp_handler.c ****             
 411:Core/Src/cell_temp_handler.c ****             // Sensor faults: only error if exceeds allowed threshold
 412:Core/Src/cell_temp_handler.c ****             if (sensor_fault_count > MAX_THERM_FAULT_ALLOWED) {
 413:Core/Src/cell_temp_handler.c ****                 ErrorMgr_SetError(ERROR_TEMP_SENSOR_FAULT);
 414:Core/Src/cell_temp_handler.c ****             } else {
 415:Core/Src/cell_temp_handler.c ****                 ErrorMgr_ClearError(ERROR_TEMP_SENSOR_FAULT);
 416:Core/Src/cell_temp_handler.c ****             }
 417:Core/Src/cell_temp_handler.c ****             
 418:Core/Src/cell_temp_handler.c ****             // Under-temp: only error if exceeds allowed threshold (broken thermistors read cold)
 419:Core/Src/cell_temp_handler.c ****             if (under_temp_count > MAX_THERM_FAULT_ALLOWED) {
 420:Core/Src/cell_temp_handler.c ****                 ErrorMgr_SetError(ERROR_UNDER_TEMP);
 421:Core/Src/cell_temp_handler.c ****             } else {
 422:Core/Src/cell_temp_handler.c ****                 ErrorMgr_ClearError(ERROR_UNDER_TEMP);
 423:Core/Src/cell_temp_handler.c ****             }
 424:Core/Src/cell_temp_handler.c ****             
 425:Core/Src/cell_temp_handler.c ****             // Send temperature summary message every 5 seconds
 426:Core/Src/cell_temp_handler.c ****             uint32_t current_tick = osKernelGetTickCount();
 427:Core/Src/cell_temp_handler.c ****             if ((current_tick - last_summary_tick) >= TEMP_SUMMARY_INTERVAL_MS) {
 428:Core/Src/cell_temp_handler.c ****                 CellTemp_SendSummaryMessage();
 429:Core/Src/cell_temp_handler.c ****                 last_summary_tick = current_tick;
