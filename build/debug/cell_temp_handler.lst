 373:Core/Src/cell_temp_handler.c ****         // Check if we completed full cycle of all MUX channels
 374:Core/Src/cell_temp_handler.c ****         if (temp_state.current_mux >= MUX_CHANNELS) {
 375:Core/Src/cell_temp_handler.c ****             temp_state.current_mux = 0;
 376:Core/Src/cell_temp_handler.c ****             temp_state.cycle_count++;
 377:Core/Src/cell_temp_handler.c ****             
 378:Core/Src/cell_temp_handler.c ****             // After completing a full cycle, check if all thermistors are within limits
 379:Core/Src/cell_temp_handler.c ****             // If so, clear the error flags
 380:Core/Src/cell_temp_handler.c ****             uint8_t any_over_temp = 0;
 381:Core/Src/cell_temp_handler.c ****             uint8_t any_under_temp = 0;
 382:Core/Src/cell_temp_handler.c ****             uint8_t any_sensor_fault = 0;
 383:Core/Src/cell_temp_handler.c ****             
 384:Core/Src/cell_temp_handler.c ****             for (uint8_t i = 0; i < TOTAL_THERMISTORS; i++) {
 385:Core/Src/cell_temp_handler.c ****                 // Only check enabled ADC channels and thermistors with fault detection enabled
 386:Core/Src/cell_temp_handler.c ****                 uint8_t therm_adc = i / MUX_CHANNELS;
 387:Core/Src/cell_temp_handler.c ****                 if (CellTemp_IsADCEnabled(therm_adc) && CellTemp_IsFaultDetectionEnabled(i)) {
 388:Core/Src/cell_temp_handler.c ****                     float temp = temp_state.thermistors[i].temperature;
 389:Core/Src/cell_temp_handler.c ****                     
 390:Core/Src/cell_temp_handler.c ****                     if (temp <= -126.0f) {
 391:Core/Src/cell_temp_handler.c ****                         // Invalid reading - sensor fault
 392:Core/Src/cell_temp_handler.c ****                         any_sensor_fault = 1;
 393:Core/Src/cell_temp_handler.c ****                     } else if (temp > temp_max_threshold) {
 394:Core/Src/cell_temp_handler.c ****                         // Over temperature
 395:Core/Src/cell_temp_handler.c ****                         any_over_temp = 1;
 396:Core/Src/cell_temp_handler.c ****                     } else if (temp < TEMP_MIN_CELSIUS) {
 397:Core/Src/cell_temp_handler.c ****                         // Under temperature
 398:Core/Src/cell_temp_handler.c ****                         any_under_temp = 1;
 399:Core/Src/cell_temp_handler.c ****                     }
 400:Core/Src/cell_temp_handler.c ****                 }
 401:Core/Src/cell_temp_handler.c ****             }
 402:Core/Src/cell_temp_handler.c ****             
 403:Core/Src/cell_temp_handler.c ****             // Clear error flags if all thermistors are within bounds
 404:Core/Src/cell_temp_handler.c ****             if (!any_over_temp) {
 405:Core/Src/cell_temp_handler.c ****                 ErrorMgr_ClearError(ERROR_OVER_TEMP);
 406:Core/Src/cell_temp_handler.c ****             }
 407:Core/Src/cell_temp_handler.c ****             if (!any_under_temp) {
 408:Core/Src/cell_temp_handler.c ****                 ErrorMgr_ClearError(ERROR_UNDER_TEMP);
 409:Core/Src/cell_temp_handler.c ****             }
 410:Core/Src/cell_temp_handler.c ****             if (!any_sensor_fault) {
 411:Core/Src/cell_temp_handler.c ****                 ErrorMgr_ClearError(ERROR_TEMP_SENSOR_FAULT);
 412:Core/Src/cell_temp_handler.c ****             }
 413:Core/Src/cell_temp_handler.c ****         }
 414:Core/Src/cell_temp_handler.c ****     }
