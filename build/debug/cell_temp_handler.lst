 354:Core/Src/cell_temp_handler.c ****                         // Send message 0 for this ADC (thermistors 0-3)
 355:Core/Src/cell_temp_handler.c ****                         uint8_t msg_idx = adc * 2;
 356:Core/Src/cell_temp_handler.c ****                         uint8_t start_therm_idx = adc * MUX_CHANNELS;
 357:Core/Src/cell_temp_handler.c ****                         CellTemp_SendTemperatureMessage(msg_idx, start_therm_idx);
 358:Core/Src/cell_temp_handler.c ****                         osDelay(2); // Small delay between messages
 359:Core/Src/cell_temp_handler.c ****                     } else {
 360:Core/Src/cell_temp_handler.c ****                         // Send message 1 for this ADC (thermistors 4-7)
 361:Core/Src/cell_temp_handler.c ****                         uint8_t msg_idx = adc * 2 + 1;
 362:Core/Src/cell_temp_handler.c ****                         uint8_t start_therm_idx = adc * MUX_CHANNELS + 4;
 363:Core/Src/cell_temp_handler.c ****                         CellTemp_SendTemperatureMessage(msg_idx, start_therm_idx);
 364:Core/Src/cell_temp_handler.c ****                         osDelay(2); // Small delay between messages
 365:Core/Src/cell_temp_handler.c ****                     }
 366:Core/Src/cell_temp_handler.c ****                 }
 367:Core/Src/cell_temp_handler.c ****             }
 368:Core/Src/cell_temp_handler.c ****         }
 369:Core/Src/cell_temp_handler.c ****         
 370:Core/Src/cell_temp_handler.c ****         // Move to next MUX channel
 371:Core/Src/cell_temp_handler.c ****         temp_state.current_mux++;
 372:Core/Src/cell_temp_handler.c ****         
