  99:Core/Src/cell_temp_handler.c **** /**
 100:Core/Src/cell_temp_handler.c ****   * @brief  Read single ADC value from specified channel
 101:Core/Src/cell_temp_handler.c ****   * @param  adc_channel: ADC channel to read
 102:Core/Src/cell_temp_handler.c ****   * @retval ADC value (0-4095)
 103:Core/Src/cell_temp_handler.c ****   */
 104:Core/Src/cell_temp_handler.c **** uint16_t CellTemp_ReadADC(uint32_t adc_channel)
 105:Core/Src/cell_temp_handler.c **** {
 106:Core/Src/cell_temp_handler.c ****     uint16_t adc_value = 0;
 107:Core/Src/cell_temp_handler.c ****     
 108:Core/Src/cell_temp_handler.c ****     // Configure ADC for the specified channel
 109:Core/Src/cell_temp_handler.c ****     if (CellTemp_ConfigureADCChannel(adc_channel) != HAL_OK) {
 110:Core/Src/cell_temp_handler.c ****         return 0;
 111:Core/Src/cell_temp_handler.c ****     }
 112:Core/Src/cell_temp_handler.c ****     
 113:Core/Src/cell_temp_handler.c ****     // Start ADC conversion
 114:Core/Src/cell_temp_handler.c ****     if (HAL_ADC_Start(&hadc1) == HAL_OK) {
 115:Core/Src/cell_temp_handler.c ****         // Wait for conversion to complete
 116:Core/Src/cell_temp_handler.c ****         if (HAL_ADC_PollForConversion(&hadc1, HAL_MAX_DELAY) == HAL_OK) {
 117:Core/Src/cell_temp_handler.c ****             // Get ADC value
 118:Core/Src/cell_temp_handler.c ****             adc_value = HAL_ADC_GetValue(&hadc1);
 119:Core/Src/cell_temp_handler.c ****         }
 120:Core/Src/cell_temp_handler.c ****         // Stop ADC
 121:Core/Src/cell_temp_handler.c ****         HAL_ADC_Stop(&hadc1);
 122:Core/Src/cell_temp_handler.c ****     }
 123:Core/Src/cell_temp_handler.c ****     
 124:Core/Src/cell_temp_handler.c ****     return adc_value;
 125:Core/Src/cell_temp_handler.c **** }
