 640:Core/Src/main.c **** void vApplicationMallocFailedHook(void)
 641:Core/Src/main.c **** {
 642:Core/Src/main.c ****   /* Called if a call to pvPortMalloc() fails because there is insufficient
 643:Core/Src/main.c ****      free memory available in the FreeRTOS heap. This usually means the heap
 644:Core/Src/main.c ****      size is too small. Blink MUX_SIG1 rapidly to indicate heap failure. */
