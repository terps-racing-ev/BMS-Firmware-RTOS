 646:Core/Src/main.c ****   for(;;) {
 647:Core/Src/main.c ****     HAL_GPIO_TogglePin(GPIOB, MUX_SIG1_Pin);
 648:Core/Src/main.c ****     for(volatile uint32_t i = 0; i < 100000; i++);  // Busy wait
 649:Core/Src/main.c ****   }
 650:Core/Src/main.c **** }
