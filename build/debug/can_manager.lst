 420:Core/Src/can_manager.c **** /**
 421:Core/Src/can_manager.c ****   * @brief  CAN RX FIFO 0 message pending callback
 422:Core/Src/can_manager.c ****   * @param  hcan: pointer to CAN handle
 423:Core/Src/can_manager.c ****   * @retval None
 424:Core/Src/can_manager.c ****   */
 425:Core/Src/can_manager.c **** void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
 426:Core/Src/can_manager.c **** {
 427:Core/Src/can_manager.c ****     CAN_RxHeaderTypeDef RxHeader;
 428:Core/Src/can_manager.c ****     CAN_Message_t msg;
 429:Core/Src/can_manager.c ****     
 430:Core/Src/can_manager.c ****     // Get message from FIFO
 431:Core/Src/can_manager.c ****     if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &RxHeader, msg.data) == HAL_OK) {
 432:Core/Src/can_manager.c ****         // Store message details (all messages are extended ID)
 433:Core/Src/can_manager.c ****         msg.id = RxHeader.ExtId;
 434:Core/Src/can_manager.c ****         msg.length = RxHeader.DLC;
 435:Core/Src/can_manager.c ****         msg.priority = 0;  // RX messages don't have priority
 436:Core/Src/can_manager.c ****         msg.timestamp = osKernelGetTickCount();
 437:Core/Src/can_manager.c ****         
 438:Core/Src/can_manager.c ****         // Ignore all messages not for this module
 439:Core/Src/can_manager.c ****         if (CAN_IsMessageForThisModule(msg.id)) {
 440:Core/Src/can_manager.c ****                 // Add to RX queue (from ISR context)
 441:Core/Src/can_manager.c ****             if (osMessageQueuePut(CANRxQueueHandle, &msg, 0, 0) != osOK) {
 442:Core/Src/can_manager.c ****                 can_stats.rx_queue_full_count++;
 443:Core/Src/can_manager.c ****             }
 444:Core/Src/can_manager.c ****         }
 445:Core/Src/can_manager.c ****     }
 446:Core/Src/can_manager.c **** }
