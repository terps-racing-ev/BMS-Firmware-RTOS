 235:Core/Src/can_manager.c **** /**
 236:Core/Src/can_manager.c ****   * @brief  Process received CAN message
 237:Core/Src/can_manager.c ****   * @param  msg: Pointer to received message
 238:Core/Src/can_manager.c ****   * @retval None
 239:Core/Src/can_manager.c ****   */
 240:Core/Src/can_manager.c **** static void CAN_ProcessRxMessage(CAN_Message_t *msg)
 241:Core/Src/can_manager.c **** {
 242:Core/Src/can_manager.c ****     // RX messages not for this module are filtered out
 243:Core/Src/can_manager.c ****     // in the HAL callback function
 244:Core/Src/can_manager.c **** 
 245:Core/Src/can_manager.c ****     can_stats.rx_message_count++;
 246:Core/Src/can_manager.c **** 
 247:Core/Src/can_manager.c ****     // Check for debug info request FIRST (broadcast message)
 248:Core/Src/can_manager.c ****     if (msg->id == CAN_DEBUG_REQUEST_ID) {
 249:Core/Src/can_manager.c ****         // Send debug info response
 250:Core/Src/can_manager.c ****         CAN_SendDebugInfo();
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccuFD6Ei.s 			page 66


 251:Core/Src/can_manager.c ****         // Also send I2C diagnostics
 252:Core/Src/can_manager.c ****         CAN_SendI2CDiagnostics();
 253:Core/Src/can_manager.c ****         return;
 254:Core/Src/can_manager.c ****     }
 255:Core/Src/can_manager.c **** 
 256:Core/Src/can_manager.c ****     // Strip module ID to get base message ID (for message type identification)
 257:Core/Src/can_manager.c ****     uint32_t base_id = msg->id & 0xFFFF0FFF;
 258:Core/Src/can_manager.c **** 
 259:Core/Src/can_manager.c ****     // Check for configuration command message
 260:Core/Src/can_manager.c ****     if (base_id == (CAN_CONFIG_CMD_BASE & 0xFFFF0FFF)) {
 261:Core/Src/can_manager.c ****         Config_ProcessCANCommand(msg->data, msg->length);
 262:Core/Src/can_manager.c ****         return;
 263:Core/Src/can_manager.c ****     }
 264:Core/Src/can_manager.c ****     
 265:Core/Src/can_manager.c ****     // Check for reset command message
 266:Core/Src/can_manager.c ****     if (base_id == (CAN_RESET_CMD_BASE & 0xFFFF0FFF)) {
 267:Core/Src/can_manager.c ****         // Reset command - trigger NVIC system reset
 268:Core/Src/can_manager.c ****         NVIC_SystemReset();
 269:Core/Src/can_manager.c ****         return;  // Never reached, but good practice
 270:Core/Src/can_manager.c ****     }
 271:Core/Src/can_manager.c ****     
 272:Core/Src/can_manager.c ****     // Check for BMS chip reset command message
 273:Core/Src/can_manager.c ****     if (base_id == (CAN_BMS_RESET_CMD_BASE & 0xFFFF0FFF)) {
 274:Core/Src/can_manager.c ****         // BMS chip reset command - signal reset handler task via semaphore
 275:Core/Src/can_manager.c ****         // This prevents blocking the CAN manager during the 600ms reset sequence
 276:Core/Src/can_manager.c ****         uint8_t ack_data[8] = {0};
 277:Core/Src/can_manager.c ****         osStatus_t sem_result = osOK;
 278:Core/Src/can_manager.c ****         
 279:Core/Src/can_manager.c ****         // Signal the BMS reset handler task (non-blocking)
 280:Core/Src/can_manager.c ****         if (BMSResetSemHandle != NULL) {
 281:Core/Src/can_manager.c ****             sem_result = osSemaphoreRelease(BMSResetSemHandle);
 282:Core/Src/can_manager.c ****         } else {
 283:Core/Src/can_manager.c ****             sem_result = osError;
 284:Core/Src/can_manager.c ****         }
 285:Core/Src/can_manager.c ****         
 286:Core/Src/can_manager.c ****         // Prepare acknowledgement message
 287:Core/Src/can_manager.c ****         // Byte 0: Status (0x00 = success/queued, 0x01 = fail/already pending)
 288:Core/Src/can_manager.c ****         // Bytes 1-7: Reserved
 289:Core/Src/can_manager.c ****         ack_data[0] = (sem_result == osOK) ? 0x00 : 0x01;
 290:Core/Src/can_manager.c ****         ack_data[1] = 0x00;
 291:Core/Src/can_manager.c ****         ack_data[2] = 0x00;
 292:Core/Src/can_manager.c ****         ack_data[3] = 0x00;
 293:Core/Src/can_manager.c ****         ack_data[4] = 0x00;
 294:Core/Src/can_manager.c ****         ack_data[5] = 0x00;
 295:Core/Src/can_manager.c ****         ack_data[6] = 0x00;
 296:Core/Src/can_manager.c ****         ack_data[7] = 0x00;
 297:Core/Src/can_manager.c ****         
 298:Core/Src/can_manager.c ****         // Send acknowledgement
 299:Core/Src/can_manager.c ****         CAN_SendMessage(CAN_BMS_RESET_ACK_ID, ack_data, 8, CAN_PRIORITY_HIGH);
 300:Core/Src/can_manager.c ****         return;
 301:Core/Src/can_manager.c ****     }
 302:Core/Src/can_manager.c ****     
 303:Core/Src/can_manager.c **** }
 304:Core/Src/can_manager.c **** 
 305:Core/Src/can_manager.c **** /**
 306:Core/Src/can_manager.c ****   * @brief  Main CAN manager task
 307:Core/Src/can_manager.c ****   * @param  argument: Not used
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccuFD6Ei.s 			page 67


 308:Core/Src/can_manager.c ****   * @retval None
 309:Core/Src/can_manager.c ****   */
 310:Core/Src/can_manager.c **** void CAN_ManagerTask(void *argument)
 311:Core/Src/can_manager.c **** {
 312:Core/Src/can_manager.c ****     CAN_Message_t rx_msg;
 313:Core/Src/can_manager.c ****     uint32_t last_heartbeat_tick = 0;
 314:Core/Src/can_manager.c ****     uint32_t last_stats_tick = 0;
 315:Core/Src/can_manager.c ****     uint32_t last_uptime_tick = 0;
 316:Core/Src/can_manager.c ****     uint32_t current_tick = 0;
 317:Core/Src/can_manager.c ****     
 318:Core/Src/can_manager.c ****     // Wait 100ms for system to stabilize
 319:Core/Src/can_manager.c ****     osDelay(100);
 320:Core/Src/can_manager.c ****     
 321:Core/Src/can_manager.c ****     // Initialize timing
 322:Core/Src/can_manager.c ****     last_heartbeat_tick = osKernelGetTickCount();
 323:Core/Src/can_manager.c ****     last_stats_tick = osKernelGetTickCount();
 324:Core/Src/can_manager.c ****     last_uptime_tick = osKernelGetTickCount();
 325:Core/Src/can_manager.c ****     
 326:Core/Src/can_manager.c ****     /* Infinite loop */
 327:Core/Src/can_manager.c ****     for(;;)
 328:Core/Src/can_manager.c ****     {
 329:Core/Src/can_manager.c ****         current_tick = osKernelGetTickCount();
 330:Core/Src/can_manager.c ****         
 331:Core/Src/can_manager.c ****         // Process any received messages from RX queue
 332:Core/Src/can_manager.c ****         while (osMessageQueueGet(CANRxQueueHandle, &rx_msg, NULL, 0) == osOK) {
 333:Core/Src/can_manager.c ****             CAN_ProcessRxMessage(&rx_msg);
 334:Core/Src/can_manager.c ****         }
 335:Core/Src/can_manager.c ****         
 336:Core/Src/can_manager.c ****         // Process TX queue and send pending messages
 337:Core/Src/can_manager.c ****         CAN_ProcessTxQueue();
 338:Core/Src/can_manager.c ****         
 339:Core/Src/can_manager.c ****         // Send heartbeat message at regular intervals
 340:Core/Src/can_manager.c ****         if ((current_tick - last_heartbeat_tick) >= CAN_HEARTBEAT_INTERVAL_MS) {
 341:Core/Src/can_manager.c ****             CAN_SendHeartbeat();
 342:Core/Src/can_manager.c ****             last_heartbeat_tick = current_tick;
 343:Core/Src/can_manager.c ****         }
 344:Core/Src/can_manager.c ****         
 345:Core/Src/can_manager.c ****         // Send statistics message at regular intervals (every 1 second)
 346:Core/Src/can_manager.c ****         if ((current_tick - last_stats_tick) >= 1000) {
 347:Core/Src/can_manager.c ****             CAN_SendStatistics();
 348:Core/Src/can_manager.c ****             last_stats_tick = current_tick;
 349:Core/Src/can_manager.c ****         }
 350:Core/Src/can_manager.c ****         
 351:Core/Src/can_manager.c ****         // Update uptime counter every second
 352:Core/Src/can_manager.c ****         if ((current_tick - last_uptime_tick) >= 1000) {
 353:Core/Src/can_manager.c ****             ErrorMgr_UpdateUptime();
 354:Core/Src/can_manager.c ****             last_uptime_tick = current_tick;
 355:Core/Src/can_manager.c ****         }
 356:Core/Src/can_manager.c ****         
 357:Core/Src/can_manager.c ****         // Small delay to prevent task from hogging CPU (10ms)
 358:Core/Src/can_manager.c ****         // The task will wake up on new messages or periodically
 359:Core/Src/can_manager.c ****         osDelay(10);
 360:Core/Src/can_manager.c ****     }
 361:Core/Src/can_manager.c **** }
 362:Core/Src/can_manager.c **** 
