 119:Core/Src/can_manager.c **** /**
 120:Core/Src/can_manager.c ****   * @brief  Send CAN message (non-blocking, queues message)
 121:Core/Src/can_manager.c ****   * @param  id: CAN message ID (29-bit extended, max 0x1FFFFFFF)
 122:Core/Src/can_manager.c ****   * @param  data: Pointer to data buffer (up to 8 bytes)
 123:Core/Src/can_manager.c ****   * @param  length: Data length (0-8 bytes)
 124:Core/Src/can_manager.c ****   * @param  priority: Message priority (0 = highest, 3 = lowest)
 125:Core/Src/can_manager.c ****   * @retval HAL_StatusTypeDef
 126:Core/Src/can_manager.c ****   */
 127:Core/Src/can_manager.c **** HAL_StatusTypeDef CAN_SendMessage(uint32_t id, uint8_t *data, uint8_t length, uint8_t priority)
 128:Core/Src/can_manager.c **** {
 129:Core/Src/can_manager.c ****     CAN_Message_t msg;
 130:Core/Src/can_manager.c ****     
 131:Core/Src/can_manager.c ****     // Validate inputs (29-bit extended ID max)
 132:Core/Src/can_manager.c ****     if (length > 8 || id > 0x1FFFFFFF) {
ARM GAS  C:\Users\Ali\AppData\Local\Temp\ccuFD6Ei.s 			page 57


 133:Core/Src/can_manager.c ****         return HAL_ERROR;
 134:Core/Src/can_manager.c ****     }
 135:Core/Src/can_manager.c ****     
 136:Core/Src/can_manager.c ****     // ID is already configured with module offset at startup
 137:Core/Src/can_manager.c ****     // No need to apply offset here anymore
 138:Core/Src/can_manager.c ****     
 139:Core/Src/can_manager.c ****     // Prepare message
 140:Core/Src/can_manager.c ****     msg.id = id;
 141:Core/Src/can_manager.c ****     msg.length = length;
 142:Core/Src/can_manager.c ****     msg.priority = priority;
 143:Core/Src/can_manager.c ****     msg.timestamp = osKernelGetTickCount();
 144:Core/Src/can_manager.c ****     
 145:Core/Src/can_manager.c ****     // Copy data
 146:Core/Src/can_manager.c ****     if (data != NULL && length > 0) {
 147:Core/Src/can_manager.c ****         memcpy(msg.data, data, length);
 148:Core/Src/can_manager.c ****     }
 149:Core/Src/can_manager.c ****     
 150:Core/Src/can_manager.c ****     // Add to queue (non-blocking with timeout in ms)
 151:Core/Src/can_manager.c ****     if (osMessageQueuePut(CANTxQueueHandle, &msg, priority, CAN_TX_TIMEOUT_MS) != osOK) {
 152:Core/Src/can_manager.c ****         can_stats.tx_queue_full_count++;
 153:Core/Src/can_manager.c ****         return HAL_ERROR;
 154:Core/Src/can_manager.c ****     }
 155:Core/Src/can_manager.c ****     
 156:Core/Src/can_manager.c ****     return HAL_OK;
 157:Core/Src/can_manager.c **** }
