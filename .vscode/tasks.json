{
	"version": "2.0.0",
	"tasks": [
        {
            "label": "Build App A+B",
            "type": "shell",
            "command": "make",
            "args": [
                "-f",
                "dual_build.mk"
            ],
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build STM",
            "type": "process",
            "command": "${command:stm32-for-vscode.build}",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Clean STM",
            "type": "process",
            "command": "${command:stm32-for-vscode.cleanBuild}",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Flash STM",
            "type": "process",
            "command": "${command:stm32-for-vscode.flash}",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build App A+B and Upload zfpi",
            "type": "shell",
            "command": "make -f dual_build.mk; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; scp build/bank_a/debug/BMS-Firmware-RTOS_a.bin build/bank_a/debug/BMS-Firmware-RTOS_a.hex build/bank_b/debug/BMS-Firmware-RTOS_b.bin build/bank_b/debug/BMS-Firmware-RTOS_b.hex ali@zfpi.local:/home/ali/",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}